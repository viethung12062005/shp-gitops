{
  "realm": "shp",
  "enabled": true,
  "displayName": "Smart Hospital",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "patient",
        "description": "Patient"
      },
      {
        "name": "doctor",
        "description": "Doctor",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "nurse",
        "description": "Nurse",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "admin",
        "description": "Administrator",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "dpo",
        "description": "Data protection officer",
        "composites": {
          "realm": [
            "mfa-required"
          ]
        }
      },
      {
        "name": "mfa-required",
        "description": "Marker included in every staff role: the browser flow demands a TOTP code from its holders (IAM-10)"
      },
      {
        "name": "internal.clinical",
        "description": "May call /internal of clinical"
      },
      {
        "name": "internal.document",
        "description": "May call /internal of document"
      },
      {
        "name": "internal.ml",
        "description": "May call /internal of ml"
      },
      {
        "name": "internal.notification",
        "description": "May call /internal of notification"
      },
      {
        "name": "internal.scheduling",
        "description": "May call /internal of scheduling"
      }
    ]
  },
  "clients": [
    {
      "clientId": "shp-web",
      "name": "Smart Hospital web (PWA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://${SHP_PUBLIC_HOST}/*"
      ],
      "webOrigins": [
        "https://${SHP_PUBLIC_HOST}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-shp-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "amr-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-svc-ai",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "svc-ai",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shp-api",
      "name": "Smart Hospital API (audience)",
